---
import type { Post } from '../lib/materials';
import { formatDate } from '../lib/labels';
import Item from './Item.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post">
  <div class="meta">
    <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
  </div>
  <h2>{post.title}</h2>
  {post.text && <p class="text">{post.text}</p>}
  {post.items.length > 0 && (
    <div class="items">
      {post.items.map((item) => <Item item={item} />)}
    </div>
  )}
</article>

<style>
  .post {
    background: var(--surface);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px 8px;
    margin-bottom: 16px;
  }
  .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 2px; }
  h2 { font-size: 1.25rem; margin-bottom: 6px; }
  .text { margin: 0 0 10px; white-space: pre-line; }
  .items { margin-top: 6px; }
  .post > :last-child:not(.items) { margin-bottom: 10px; }
</style>
