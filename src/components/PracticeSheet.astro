---
import { t } from '../lib/labels';

interface Props {
  sheet?: 'kt1' | 'kt2';
  label?: string;
}

const { sheet = 'kt1', label } = Astro.props;
---

<details class="game" data-practice data-sheet={sheet}>
  <summary class="game-label">
    <span>{label || t.practice.title}</span>
    <span class="toggle"><span class="when-closed">{t.practice.open}</span><span class="when-open">{t.practice.close}</span></span>
  </summary>
  <div class="box">
    <p class="intro">{t.practice.intro}</p>
    <p class="score" data-score></p>
    <div data-sections></div>
  </div>
</details>

<script>
  import { t } from '../lib/labels';

  import { sheets } from '../lib/practice';
  import type { Field, Question } from '../lib/practice';

  const trimZeros = (s: string) => s.replace(/^0+(?=.)/, '');
  function correct(field: Field, raw: string): boolean {
    const value = raw.trim();
    if (!value) return false;
    const answers = Array.isArray(field.answer) ? field.answer : [field.answer];
    switch (field.kind) {
      case 'num': {
        const n = Number(value.replace(/\s/g, '').replace(',', '.').replace(/[^\d.]+$/, ''));
        return answers.some((a) => n === Number(a));
      }
      case 'bin':
        return answers.some((a) => trimZeros(value.replace(/\s/g, '')) === trimZeros(a));
      case 'hex': {
        const v = trimZeros(value.toUpperCase().replace(/\s/g, '').replace(/^(#|0X)/, ''));
        return answers.some((a) => v === trimZeros(a.toUpperCase()));
      }
      case 'text':
        return answers.includes(value);
      case 'codes':
        return answers.some((a) => (value.match(/\d+/g) ?? []).join(' ') === a);
      case 'word': {
        const v = value.toLowerCase().replace(/\s+/g, ' ');
        return answers.some((a) => v === a.toLowerCase());
      }
      case 'compact': {
        const v = value.toUpperCase().replace(/\s/g, '');
        return answers.some((a) => v === a.toUpperCase());
      }
      case 'list': {
        const v = value.toLowerCase().split(/[^\p{L}\d]+/u).filter(Boolean).join(' ');
        return answers.some((a) => v === a.toLowerCase());
      }
    }
  }

  function setup(root: HTMLElement) {
    const sections = sheets[root.dataset.sheet ?? 'kt1'] ?? sheets.kt1;
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const sectionsEl = root.querySelector<HTMLElement>('[data-sections]')!;
    const solved = new Set<Question>();
    const checkable = sections.flatMap((s) => s.questions).filter((q) => !q.open).length;
    const updateScore = () => (scoreEl.textContent = t.practice.score(solved.size, checkable));

    for (const section of sections) {
      const heading = document.createElement('h3');
      heading.textContent = section.title;
      sectionsEl.append(heading);

      section.questions.forEach((q) => {
        const box = document.createElement('div');
        box.className = 'question';
        const text = document.createElement('p');
        text.className = 'q-text';
        text.textContent = q.text;
        box.append(text);

        const inputs = q.fields.map((field) => {
          const wrap = document.createElement('label');
          wrap.className = 'field';
          const span = document.createElement('span');
          span.textContent = field.label;
          const input = document.createElement('input');
          input.autocomplete = 'off';
          input.spellcheck = false;
          input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') check();
          });
          wrap.append(span, input);
          box.append(wrap);
          return input;
        });
        if (q.open) {
          const area = document.createElement('textarea');
          area.rows = 2;
          area.setAttribute('aria-label', t.practice.yourAnswer);
          area.placeholder = t.practice.yourAnswer;
          box.append(area);
        }

        const buttons = document.createElement('div');
        buttons.className = 'buttons';
        const checkBtn = document.createElement('button');
        checkBtn.type = 'button';
        checkBtn.className = 'btn';
        checkBtn.textContent = q.open ? t.practice.showModel : t.practice.check;
        const hintBtn = document.createElement('button');
        hintBtn.type = 'button';
        hintBtn.className = 'link';
        hintBtn.textContent = t.practice.hint;
        const solutionBtn = document.createElement('button');
        solutionBtn.type = 'button';
        solutionBtn.className = 'link';
        solutionBtn.textContent = t.practice.showSolution;
        solutionBtn.hidden = true;
        buttons.append(checkBtn, hintBtn, solutionBtn);
        box.append(buttons);

        const feedback = document.createElement('p');
        feedback.className = 'feedback';
        const hint = document.createElement('p');
        hint.className = 'hint';
        hint.hidden = true;
        hint.textContent = q.hint;
        const solution = document.createElement('p');
        solution.className = 'solution';
        solution.hidden = true;
        solution.textContent = q.solution;
        box.append(feedback, hint, solution);

        function check() {
          if (q.open) {
            solution.hidden = false;
            return;
          }
          if (inputs.some((i) => !i.value.trim())) {
            feedback.textContent = t.practice.fillAll;
            feedback.className = 'feedback bad';
            return;
          }
          let allRight = true;
          q.fields.forEach((field, i) => {
            const ok = correct(field, inputs[i].value);
            inputs[i].classList.toggle('ok', ok);
            inputs[i].classList.toggle('bad', !ok);
            if (!ok) allRight = false;
          });
          if (allRight) {
            solved.add(q);
            feedback.textContent = t.practice.correct;
            feedback.className = 'feedback ok';
          } else {
            solved.delete(q);
            feedback.textContent = t.practice.wrong;
            feedback.className = 'feedback bad';
            solutionBtn.hidden = false;
          }
          updateScore();
        }

        checkBtn.addEventListener('click', check);
        hintBtn.addEventListener('click', () => (hint.hidden = !hint.hidden));
        solutionBtn.addEventListener('click', () => (solution.hidden = false));
        sectionsEl.append(box);
      });
    }
    updateScore();
  }

  document.querySelectorAll<HTMLElement>('[data-practice]').forEach(setup);
</script>

<style>
  .game { padding: 14px 0; }
  .game-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-weight: 550;
    list-style: none;
    cursor: pointer;
  }
  .game-label::-webkit-details-marker { display: none; }
  .game-label:hover { border-color: var(--accent); }
  .game[open] > .game-label { margin-bottom: 8px; }
  .toggle {
    flex-shrink: 0;
    padding: 4px 12px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.85rem;
  }
  .game[open] .toggle { background: var(--accent-soft); color: var(--accent); }
  .when-open, .game[open] .when-closed { display: none; }
  .game[open] .when-open { display: inline; }
  .box { border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
  .intro { margin: 0 0 6px; }
  .score {
    position: sticky;
    top: 60px;
    z-index: 1;
    margin: 0 0 8px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--accent-soft);
    font-weight: 650;
  }
  [data-sections] :global(h3) { margin: 18px 0 8px; color: var(--accent); font-size: 1.05rem; }
  [data-sections] :global(.question) {
    margin-bottom: 10px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  [data-sections] :global(.q-text) { margin: 0 0 8px; font-weight: 550; }
  [data-sections] :global(.field) {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 10px 8px 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  [data-sections] :global(.field input),
  [data-sections] :global(textarea) {
    box-sizing: border-box;
    width: 150px;
    min-height: 40px;
    padding: 0 10px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: 600 1rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  [data-sections] :global(textarea) { width: 100%; padding: 8px 10px; font: inherit; margin-bottom: 8px; }
  [data-sections] :global(input.ok) { border-color: #2e8b57; background: rgb(46 139 87 / 0.1); }
  [data-sections] :global(input.bad) { border-color: #c0392b; background: rgb(192 57 43 / 0.08); }
  [data-sections] :global(.buttons) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  [data-sections] :global(.btn) {
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--accent);
    color: var(--on-accent);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 550;
    cursor: pointer;
  }
  [data-sections] :global(.btn:hover) { background: var(--accent-hover); border-color: var(--accent-hover); }
  [data-sections] :global(.link) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 0.9rem;
    text-decoration: underline;
    cursor: pointer;
  }
  [data-sections] :global(.feedback) { margin: 8px 0 0; min-height: 1.2em; font-weight: 600; }
  [data-sections] :global(.feedback.ok) { color: #2e8b57; }
  [data-sections] :global(.feedback.bad) { color: #c0392b; }
  [data-sections] :global(.hint),
  [data-sections] :global(.solution) { margin: 6px 0 0; padding: 8px 10px; border-radius: 8px; background: var(--accent-soft); }
  [data-sections] :global(.solution) { border-left: 4px solid #2e8b57; }
  @media (max-width: 520px) {
    .box { padding: 12px; }
    [data-sections] :global(.field) { display: flex; }
    [data-sections] :global(.field input) { width: 100%; }
  }
  @media (prefers-color-scheme: dark) {
    [data-sections] :global(.feedback.ok) { color: #6fcf97; }
    [data-sections] :global(.feedback.bad) { color: #ff8a80; }
  }
</style>
