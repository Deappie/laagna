---
// Any address that doesn't exist sends the visitor to the home page.
// GitHub Pages serves this file for every missing path under the site.
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <title>Suunan avalehele…</title>
    <script is:inline define:vars={{ home }}>
      location.replace(home);
    </script>
  </head>
  <body>
    <p><a href={home}>Mine avalehele</a></p>
  </body>
</html>
