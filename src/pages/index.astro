---
import Base from '../layouts/Base.astro';
import Post from '../components/Post.astro';
import { getCourses, getLatestPosts, getPostsForCourse, site } from '../lib/materials';
import { t } from '../lib/labels';

const base = import.meta.env.BASE_URL;
const courses = getCourses();
const latest = getLatestPosts(5);
---

<Base>
  <h1 class="title">{site.title}</h1>

  <h2 class="section-title">{t.courses}</h2>
  <ul class="courses">
    {
      courses.map((c) => (
        <li>
          <a href={`${base}${c.id}/`}>
            <span class="name">{c.title}</span>
            {c.description && <span class="desc">{c.description}</span>}
            <span class="count">{getPostsForCourse(c.id).length}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">{t.latest}</h2>
  {latest.length ? latest.map((p) => <Post post={p} showCourse />) : <p class="muted">{t.noPosts}</p>}
</Base>

<style>
  .title { font-size: 1.9rem; margin-bottom: 28px; }
  .courses {
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .courses a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    height: 100%;
    padding: 16px 44px 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
  }
  .courses a:hover { border-color: var(--accent); }
  .name { font-weight: 650; font-size: 1.1rem; }
  .desc { color: var(--muted); font-size: 0.85rem; }
  .count {
    position: absolute;
    top: 16px;
    right: 16px;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
</style>
