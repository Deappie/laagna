---
import Base from '../layouts/Base.astro';
import Post from '../components/Post.astro';
import Item from '../components/Item.astro';
import { getCourses, getPostsForCourse, type Course } from '../lib/materials';
import { t } from '../lib/labels';

export function getStaticPaths() {
  return getCourses().map((course) => ({ params: { course: course.id }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const base = import.meta.env.BASE_URL;
const posts = getPostsForCourse(course.id);
// Only this week's lesson is open: the newest post dated no later than this Sunday (weeks run Monday to Sunday).
// The script below redoes this with the viewer's date, so the right post opens even when the site was built earlier.
const now = new Date();
const sunday = new Date(now.getTime() + (7 - (now.getDay() || 7)) * 86400000).toISOString().slice(0, 10);
const found = posts.findIndex((p) => p.date.toISOString().slice(0, 10) <= sunday);
const current = found === -1 ? posts.length - 1 : found;
---

<Base title={course.title} linksHref={course.links.length ? '#lingid' : undefined}>
  <a class="back" href={base}>{t.back}</a>
  <h1 class="title">{course.title}</h1>
  {course.description && <p class="muted desc">{course.description}</p>}

  {course.links.length > 0 && (
    <section class="links" id="lingid">
      <h2>
        <svg class="pin" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 4h6l-1 6 3 3H7l3-3zM12 13v7" />
        </svg>
        {t.usefulLinks}
      </h2>
      {course.links.map((link) => <Item item={link} />)}
    </section>
  )}

  <div class="posts">
    {posts.length ? posts.map((p, i) => <Post post={p} open={i === current} />) : <p class="muted">{t.noPosts}</p>}
  </div>
</Base>

<script>
  const d = new Date();
  d.setDate(d.getDate() + 7 - (d.getDay() || 7)); // this week's Sunday
  const sunday = [d.getFullYear(), d.getMonth() + 1, d.getDate()].map((n) => String(n).padStart(2, '0')).join('-');
  const posts = [...document.querySelectorAll<HTMLElement>('.post[data-date]')];
  const found = posts.findIndex((p) => (p.dataset.date ?? '') <= sunday);
  const current = found === -1 ? posts.length - 1 : found;
  posts.forEach((p, i) => {
    const details = p.querySelector('details');
    if (details) details.open = i === current;
  });
</script>

<style>
  .back { display: inline-block; font-size: 0.9rem; margin-bottom: 14px; text-decoration: none; }
  .title { font-size: 1.9rem; }
  .desc { margin: 6px 0 0; }
  .posts { margin-top: 28px; }
  .links {
    margin-top: 28px;
    padding: 16px 20px 4px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    scroll-margin-top: 76px; /* sticky header is 60px */
  }
  .links h2 { display: flex; align-items: center; gap: 8px; font-size: 1.1rem; margin-bottom: 2px; }
  .pin {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .links + .posts { margin-top: 16px; }
</style>
